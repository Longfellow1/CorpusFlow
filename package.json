{
  "name": "corpusflow",
  "private": true,
  "version": "0.1.0",
  "description": "A corpus production workbench for LLM fine-tuning and evaluation data: turn raw queries, badcases, FAQs, and seed examples into auditable instruction-tuning (SFT) datasets you can export, in Alpaca, QA, and multi-turn formats.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Longfellow1/CorpusFlow.git"
  },
  "homepage": "https://github.com/Longfellow1/CorpusFlow#readme",
  "bugs": {
    "url": "https://github.com/Longfellow1/CorpusFlow/issues"
  },
  "keywords": [
    "fine-tuning",
    "instruction-tuning",
    "sft",
    "dataset-generation",
    "synthetic-data",
    "evaluation",
    "llm",
    "alpaca",
    "sharegpt"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:app": "tsx server.ts",
    "dev:algorithm": "uv run --project algorithm python algorithm/run.py",
    "dev:all": "concurrently -k -n app,algo \"npm:dev:app\" \"npm:dev:algorithm\"",
    "start": "node dist-server/server.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "keepalive": "tsx scripts/keepalive.ts",
    "test:regression": "tsx scripts/regression/test-regression.ts",
    "test:evaluate": "tsx scripts/regression/evaluate-prompts.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
